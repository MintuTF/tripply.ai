# Copy to .env.local for local work, and add the same values in Vercel > Project > Settings > Environment Variables.
# Never commit real keys. Anything starting with NEXT_PUBLIC_ is visible in the browser, so only put public values there.

# ---------------------------------------------------------------- REQUIRED
OPENAI_API_KEY=                  # chat, itineraries, video insights
GOOGLE_PLACES_API_KEY=           # server-side only. Needs: Places API (legacy), Geocoding API. Restrict by API, not by website.
YOUTUBE_API_KEY=                 # YouTube Data API v3 (free quota: 10,000 units/day, a search costs 100)
NEXT_PUBLIC_APP_URL=http://localhost:3000   # your real https URL in production

# ---------------------------------------------------------------- SUPABASE (accounts, saved trips, shared cache)
# Without these the app still works for guests (data stays in the browser). See supabase/README.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # SERVER ONLY. Used for share links, the video cache and admin. Never expose it.

# ---------------------------------------------------------------- EMAIL (contact form, welcome and invite emails)
RESEND_API_KEY=
EMAIL_FROM=Tripply <hello@your-domain.com>
CONTACT_EMAIL=                   # where contact-form messages are delivered

# ---------------------------------------------------------------- MODELS (optional, sensible defaults)
OPENAI_CHAT_MODEL=gpt-4o-mini    # everyday chat
OPENAI_PLACES_MODEL=gpt-4o       # reading videos: decodes noisy captions much better (about 3 cents per video, cached)
OPENAI_PLAN_MODEL=gpt-4o         # AI itinerary planner

# ---------------------------------------------------------------- MAPS FOR THE PDF GUIDE AND MAP VIEW (optional)
# The defaults use free public OpenStreetMap servers, fine for light use. Switch to a paid provider before real traffic.
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
# NEXT_PUBLIC_ROUTING_URL=https://routing.openstreetmap.de

# ---------------------------------------------------------------- ADS (optional)
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# ---------------------------------------------------------------- OTHER (optional)
RATE_LIMIT_RPM=60                # requests per minute per IP on /api (in-memory; use Redis before heavy traffic)
